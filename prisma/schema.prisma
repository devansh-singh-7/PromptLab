generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model User {
  id              String               @id @default(cuid())
  firebaseUid     String               @unique
  email           String               @unique
  displayName     String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  profile         UserProfile?
  preferences     LearningPreferences?
  domainPreferences UserDomainPreference[]
  progress        UserProgress[]
  submissions     PromptSubmission[]
}

model UserProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  explanationLanguage String @default("en")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LearningPreferences {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  learningPace   String   @default("normal")
  learningStyle  String   @default("mixed")
  availableTime  String?
  aiTool         String?
  projectType    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Domain {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  description String
  isActive    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  courses     Course[]
  preferences UserDomainPreference[]
}

model UserDomainPreference {
  id             String   @id @default(cuid())
  userId         String
  domainId       String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain         Domain   @relation(fields: [domainId], references: [id], onDelete: Cascade)
  experience     Difficulty @default(BEGINNER)
  technicalStack Json
  goals          Json
  roadmap        Json?
  approvedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@unique([userId, domainId])
}

model Course {
  id          String        @id @default(cuid())
  domainId    String
  domain      Domain        @relation(fields: [domainId], references: [id], onDelete: Cascade)
  slug        String
  title       String
  description String
  status      ContentStatus @default(DRAFT)
  modules     Module[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  @@unique([domainId, slug])
}

model Module {
  id          String        @id @default(cuid())
  courseId    String
  course      Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String
  order       Int
  lessons     Lesson[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  @@unique([courseId, order])
}

model Lesson {
  id          String        @id @default(cuid())
  moduleId    String
  module      Module        @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  slug        String
  title       String
  theory      Json
  objectives  Json
  status      ContentStatus @default(DRAFT)
  order       Int
  challenges  Challenge[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  @@unique([moduleId, slug])
  @@unique([moduleId, order])
}

model Challenge {
  id          String        @id @default(cuid())
  lessonId    String
  lesson      Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title       String
  instructions String
  rubric      Json
  hints       Json
  difficulty  Difficulty    @default(BEGINNER)
  status      ContentStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model PromptSubmission {
  id          String   @id @default(cuid())
  userId      String
  challengeId String
  promptText  String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  evaluations PromptEvaluation[]
  createdAt   DateTime @default(now())
  @@index([userId, challengeId, createdAt])
}

model PromptEvaluation {
  id           String           @id @default(cuid())
  submissionId String
  submission   PromptSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  score        Int
  dimensions   Json
  strengths    Json
  weaknesses   Json
  hints        Json
  model        String
  rubricVersion String
  createdAt    DateTime         @default(now())
}

model UserProgress {
  id         String   @id @default(cuid())
  userId     String
  lessonId   String
  completed  Boolean  @default(false)
  xp         Int      @default(0)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@unique([userId, lessonId])
}
